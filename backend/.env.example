NODE_ENV=development
PORT=3000
# Usuario de la aplicación (no root): MONGO_APP_USER / MONGO_APP_PASSWORD del .env raíz
MONGO_URI=mongodb://croper_app:cambia-esta-otra-clave@localhost:27017/?authSource=admin
MONGO_DB_NAME=croper
# Genera uno con: openssl rand -hex 32  (mínimo 32 caracteres)
JWT_SECRET=reemplaza-con-un-secreto-largo-y-aleatorio-de-32+
JWT_EXPIRES_IN=3600
CORS_ORIGIN=http://localhost:4200
