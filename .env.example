# Copiar a .env y ajustar valores: cp .env.example .env
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia-esta-clave
MONGO_DB=croper
# Usuario de la API con mínimo privilegio (readWrite solo en MONGO_DB)
MONGO_APP_USER=croper_app
MONGO_APP_PASSWORD=cambia-esta-otra-clave
# Solo desarrollo: bases extra para el usuario de la API (tests e2e)
MONGO_APP_EXTRA_DBS=croper_e2e
# Genera uno con: openssl rand -hex 32  (mínimo 32 caracteres)
JWT_SECRET=reemplaza-con-un-secreto-largo-y-aleatorio-de-32+
JWT_EXPIRES_IN=3600
